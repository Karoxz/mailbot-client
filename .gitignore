# Build output (Nuitka/PyInstaller) — regenerated by build.bat, never source
dist/
*.dist/
*.build/
*.onefile-build/
nuitka-crash-report.xml

# Python cache
__pycache__/
*.pyc

# Local secrets / credentials — never commit these
credentials.json
token.json
license_cache.json
driver_config.json

# Local per-machine runtime config/state, not source
plutus_config.json
plutus_prefs.json

# Logs
*.log
*.log.*

# Misc stray files
/python
