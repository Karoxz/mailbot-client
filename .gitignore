# Build output (Nuitka/PyInstaller) — regenerated by build.bat, never source
dist/
*.dist/
*.build/
*.onefile-build/
nuitka-crash-report.xml

# Python cache
__pycache__/
*.pyc

# Virtual environments — venv311 was the original dev env; build_venv is a
# fresh one (2026-09-08) created for the Nuitka build after venv311's base
# Python interpreter stopped existing on this machine. Neither is source.
venv/
venv311/
build_venv/

# Local secrets / credentials — never commit these
credentials.json
token.json
license_cache.json
driver_config.json

# Local per-machine runtime config/state, not source
plutus_config.json
plutus_prefs.json

# Logs
*.log
*.log.*

# Misc stray files
/python
